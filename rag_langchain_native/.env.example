# 复制为 .env.production 或通过 Secret Manager 注入；禁止提交真实值。
V3_ENVIRONMENT=production
V3_AUTH_SECRET=replace-with-at-least-32-random-characters
V3_AUTH_ISSUER=rag-langchain-native
V3_AUTH_AUDIENCE=rag-api
GEMINI_API_KEY=replace-only-when-live-answer-is-enabled
V3_CORS_ORIGINS=https://rag.example.com
V3_MAX_UPLOAD_BYTES=20971520
V3_MAX_PDF_PAGES=500
V3_RATE_LIMIT_PER_MINUTE=60
V3_MAX_CONCURRENT_REQUESTS=8
V3_LLM_TIMEOUT_SECONDS=60
